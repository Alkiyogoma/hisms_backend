[Unit]
Description=HODARI Gunicorn Application Server
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
User=hodari
Group=hodari
WorkingDirectory=/opt/hodari/hisms_backend
ExecStart=/opt/hodari/venv/bin/gunicorn config.wsgi:application \
    --config /opt/hodari/hisms_backend/deployment/gunicorn_config.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
TimeoutStartSec=60

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/hodari/hisms_backend/media /opt/hodari/hisms_backend/staticfiles /var/log/hodari /var/backups/hodari
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=no

# Environment
Environment="DJANGO_SETTINGS_MODULE=config.settings"
Environment="LANG=en_US.UTF-8"
Environment="LC_ALL=en_US.UTF-8"

# Resource limits
LimitNOFILE=65535
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
