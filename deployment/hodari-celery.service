[Unit]
Description=HODARI Celery Worker
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
User=hodari
Group=hodari
WorkingDirectory=/opt/hodari/hisms_backend
ExecStart=/opt/hodari/venv/bin/celery -A config worker \
    --loglevel=warning \
    --concurrency=4 \
    --max-tasks-per-child=1000 \
    --without-heartbeat \
    --without-mingle
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=10
KillMode=mixed
TimeoutStopSec=30

# Security
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/hodari/hisms_backend/media /opt/hodari/hisms_backend/staticfiles /var/log/hodari
PrivateTmp=yes

Environment="DJANGO_SETTINGS_MODULE=config.settings"
Environment="LANG=en_US.UTF-8"

[Install]
WantedBy=multi-user.target
