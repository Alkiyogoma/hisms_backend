[Unit]
Description=HODARI (nguzo.co.tz) Gunicorn Application Server
After=network.target postgresql.service redis.service
Wants=postgresql.service redis.service

[Service]
User=hodari
Group=hodari
WorkingDirectory=/var/www/hodari/hisms_backend
ExecStart=/var/www/hodari/venv/bin/gunicorn config.wsgi:application \
    --config /var/www/hodari/hisms_backend/deployment/nguzo/gunicorn_config.py
ExecReload=/bin/kill -s HUP $MAINPID
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=30
TimeoutStartSec=60

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/www/hodari/hisms_backend/media /var/www/hodari/hisms_backend/staticfiles /var/log/hodari-nguzo /var/run/hodari-nguzo
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
MemoryDenyWriteExecute=no

Environment="DJANGO_SETTINGS_MODULE=config.settings"
Environment="LANG=en_US.UTF-8"
Environment="LC_ALL=en_US.UTF-8"

LimitNOFILE=65535
LimitNPROC=4096

[Install]
WantedBy=multi-user.target
