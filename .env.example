# ==========================================================================
# HODARI / HISMS — environment template
# Copy to .env and fill in real values.  NEVER commit the real .env.
#   cp .env.example .env
# Generate a secret key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# ==========================================================================

# --- Core ---
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=connect.example.com,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://connect.example.com:8443

# --- Database (PostgreSQL) ---
# Leave DJANGO_USE_SQLITE=0 and set POSTGRES_PASSWORD, or the app falls back to SQLite.
# Local dev may use POSTGRES_USER=postgres; on live use a dedicated non-superuser role.
DJANGO_USE_SQLITE=0
POSTGRES_DB=hodari
POSTGRES_USER=hodari_user
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_CONN_MAX_AGE=300
POSTGRES_SSLMODE=disable

# --- Redis / Celery / Channels ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CHANNELS_REDIS_URL=redis://localhost:6379/2

# --- CORS (mobile app / SPA) ---
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://connect.example.com

# --- Email (SMTP) ---
# The only place SMTP is configured (the Settings page just shows it).
# Google Workspace: smtp.gmail.com, port 587 + TLS (or 465 + EMAIL_USE_SSL=True),
# the full mailbox as EMAIL_HOST_USER and a 16-character App Password
# (Google Account > Security > 2-Step Verification > App passwords).
# Restart gunicorn and celery after changing these.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com

# --- SMS (DarSMS bulk SMS) ---
# Sender ID is set under Settings > System (falls back to DARSMS_SENDER_ID).
SMS_PROVIDER=darsms
DARSMS_API_KEY=
DARSMS_API_URL=https://dev.darsms.co.tz/api/v1/integrations/sms/send
DARSMS_SENDER_ID=HODARI

# --- Sessions / auth throttling ---
SESSION_IDLE_TIMEOUT=1800
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=900

# --- Attendance webhooks (REQUIRED in production; fail-closed if unset) ---
# Bearer token for the Laravel <-> Django attendance webhook.
# X-Api-Key secret for physical attendance hardware.
# Generate strong values: python -c "import secrets; print(secrets.token_urlsafe(48))"
WEBHOOK_API_TOKEN=Wd9p0yqw7XfpRIdmr0vHPiHqCs-ky3Hw6QnR_RO06b0RlpLMM3udxqdCYiAVHCai

ATTENDANCE_WEBHOOK_SECRET=Wd9p0yqw7XfpRIdmr0vHPiHqCs-ky3Hw6QnR_RO06b0RlpLMM3udxqdCYiAVHCai


# --- Backups ---
BACKUP_DIR=/var/backups/hodari
BACKUP_RETENTION_DAYS=30

# --- Legacy Laravel/MySQL import (only for one-time data migration) ---
# LARAVEL_DB_HOST=127.0.0.1
# LARAVEL_DB_PORT=3306
# LARAVEL_DB_DATABASE=hodari_checkin
# LARAVEL_DB_USER=hodari_checkin
# LARAVEL_DB_PASSWORD=

# --- Error tracking / monitoring (optional) ---
# SENTRY_DSN=
# HEALTHCHECKS_PING_URL=
