# ==========================================================================
# HODARI / HISMS — Git ignore
# ==========================================================================

# --- Secrets & environment ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# --- Virtual environments ---
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# --- Django ---
*.log
db.sqlite3
db.sqlite3-journal
local_settings.py
media_email/          # JsonFileEmailBackend output (dev)
sent_emails/

# Collected static files (regenerated by `collectstatic`)
/staticfiles/

# User-uploaded media (keep committed branding assets)
/media/*
!/media/branding/

# Database dumps / backups
/backups/
*.sql
*.dump

# --- Celery ---
celerybeat-schedule
celerybeat.pid
*.pid

# --- Coverage / tests ---
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
.cache/

# --- Editors / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
